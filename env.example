# Copy this file to .env and replace all placeholder credentials before starting.

# InfluxDB initial setup
INFLUX_USERNAME=admin
INFLUX_PASSWORD=replace-with-a-strong-influxdb-password
INFLUX_ORG=iot
INFLUX_BUCKET=sensors
INFLUX_TOKEN=replace-with-a-long-random-influxdb-token

# Grafana administrator
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# MQTT credentials (must match the Mosquitto password file)
MQTT_USER=iot
MQTT_PASSWORD=replace-with-a-strong-mqtt-password
